# Copy this file to `.env` in the same folder and fill in your own values.
# Never commit the real .env — it holds secrets.

# --- Supabase ---
# Found in your Supabase project: Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
# Service role key bypasses Row Level Security — server-side only, keep it secret
SUPABASE_SERVICE_KEY=your-service-role-key

# --- Plaid ---
# Found in your Plaid dashboard: Team Settings → Keys
PLAID_CLIENT_ID=your-plaid-client-id
PLAID_SECRET=your-plaid-secret
# 'sandbox' for fake test banks, 'production' for real banks
PLAID_ENV=sandbox
